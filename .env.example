# Local / deployment environment variables for Pulse Hive Service.
# Copy to `.env` (or inject via EKS / Secrets Manager). Do not commit real secrets.
# `./gradlew bootRun` loads this file automatically.

APP_ENV=local
SERVER_PORT=8080

# Postgres (Docker Compose — keep in sync with docker-compose.yml)
POSTGRES_DB=hive
POSTGRES_USER=hive
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5435

# App on host → Compose Postgres
DB_URL=jdbc:postgresql://localhost:5435/hive
DB_USERNAME=hive
DB_PASSWORD=changeme

# HikariCP — keep total (pods × DB_POOL_MAX_SIZE) under RDS max_connections
DB_POOL_MAX_SIZE=15
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_LEAK_DETECTION_MS=60000

# Redis (Docker Compose)
REDIS_HOST=localhost
REDIS_PORT=6379

HIVE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Seeded CinchIT MSP. Must match V2 seed. Fallback is for local/dev only — leave false in prod.
HIVE_SEED_MSP_ID=00000000-0000-0000-0000-000000000001
HIVE_SEED_MSP_FALLBACK_ENABLED=true

# Background poll of Core job status. Tests set this false. Cron is Spring 6-field.
HIVE_PROVISIONING_POLL_ENABLED=true
HIVE_PROVISIONING_POLL_CRON=0/30 * * * * *

# Portal26 Core partner gateway — base URL must include /partner-gateway for real Core.
CORE_BASE_URL=http://localhost:8081
CORE_INTERNAL_CLIENT_ID=test-secret
CORE_CONNECT_TIMEOUT_MS=3000
CORE_READ_TIMEOUT_MS=10000

ACTUATOR_ENDPOINTS=health,info,metrics
ACTUATOR_HEALTH_SHOW_DETAILS=always

# Cognito User Pool — values from Hive-Poc Terraform (`portal26-hive-auth-poc/infra/cognito`)
# After apply: copy from docs/aws/cognito-config.json (domain, pool id) + terraform output backend_app_client_*
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER_URI=
# Hosted UI domain (no trailing slash), e.g. https://portal26-hive-auth-poc.auth.ap-south-1.amazoncognito.com
COGNITO_DOMAIN=
# Must match hive_api_callback_urls in Terraform tfvars → Hive API
COGNITO_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
COGNITO_FRONTEND_SUCCESS_URL=http://localhost:3000
COGNITO_FRONTEND_ERROR_URL=http://localhost:3000
# Must match hive_api_logout_urls in Terraform
COGNITO_LOGOUT_URI=http://localhost:3000
AWS_PROFILE=
# Create admin@portal26.ai via SDK on startup if missing (local/dev only)
COGNITO_BOOTSTRAP_ADMIN=true
COGNITO_BOOTSTRAP_EMAIL=admin@portal26.ai
COGNITO_BOOTSTRAP_PASSWORD=Admin@123
# Written to Cognito custom:provider on bootstrap; Hive find-or-creates msp by this name on login
COGNITO_BOOTSTRAP_PROVIDER=CinchIT

# Hive session cookie (opaque id only; TTL aligned with Cognito refresh ~7d).
# SameSite=Lax assumes UI and API share a host (or UI proxies /api/v1/auth/callback).
# Set HIVE_SESSION_COOKIE_SECURE=true in HTTPS/prod.
HIVE_SESSION_COOKIE_NAME=HIVE_SESSION
HIVE_SESSION_TTL=7d
HIVE_SESSION_COOKIE_SECURE=false
