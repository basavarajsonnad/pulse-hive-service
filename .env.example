# Local / deployment environment variables for Pulse Hive Service.
# Copy to `.env` (or inject via EKS / Secrets Manager). Do not commit real secrets.
# `./gradlew bootRun` loads this file automatically.

APP_ENV=local
SERVER_PORT=8080

# Postgres (Docker Compose — keep in sync with docker-compose.yml)
POSTGRES_DB=hive
POSTGRES_USER=hive
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5435

# App on host → Compose Postgres
DB_URL=jdbc:postgresql://localhost:5435/hive
DB_USERNAME=hive
DB_PASSWORD=changeme

# HikariCP — keep total (pods × DB_POOL_MAX_SIZE) under RDS max_connections
DB_POOL_MAX_SIZE=15
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_LEAK_DETECTION_MS=60000

CORE_BASE_URL=https://core.example.local
CORE_HTTP_CONNECT_TIMEOUT_MS=3000
CORE_HTTP_RESPONSE_TIMEOUT_MS=10000
CORE_HTTP_MAX_CONNECTIONS=100
CORE_HTTP_MAX_IDLE_TIME_MS=30000
CORE_HTTP_PENDING_ACQUIRE_TIMEOUT_MS=45000
CORE_HTTP_METRICS_ENABLED=true

DATASOURCE_PROXY_ENABLED=true
DATASOURCE_PROXY_SLOW_QUERY_LOG=true
DATASOURCE_PROXY_SLOW_QUERY_MS=300
DATASOURCE_PROXY_COUNT_QUERY=true
HIBERNATE_GENERATE_STATISTICS=false
HIBERNATE_SLOW_QUERY_MS=500

HIVE_CORS_ALLOWED_ORIGINS=http://localhost:3000
HIVE_SECURITY_DEV_HEADERS=true

ACTUATOR_ENDPOINTS=health,info,metrics
ACTUATOR_HEALTH_SHOW_DETAILS=always

HIVE_PROVISIONING_POLL_MS=5000
HIVE_REPORTING_POLL_MS=10000
HIVE_SYNC_POLL_MS=60000
